[Unit]
Description=TeachForth IDE power panel
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/teachforth-ide
Environment=HOME=/root
Environment=HOST=127.0.0.1
Environment=PORT=8791
Environment=BASE=/teachforth-power
ExecStart=/root/.nvm/versions/node/v24.16.0/bin/node /root/teachforth-ide/deploy/power-server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
